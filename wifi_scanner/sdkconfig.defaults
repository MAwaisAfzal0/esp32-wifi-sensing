# --- target ---
CONFIG_IDF_TARGET="esp32"

# --- Wi-Fi: plenty of RX buffers, the radio is promiscuous here ---
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=128
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# --- console / flashing link ---
# 460800 rather than the default: this CH340 link already corrupted a bulk
# 921600 read on this machine. UART_DEFAULT would pin the console to 115200 and
# ignore the baudrate symbol, so CUSTOM is required to honour it.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=460800

# 4 MB flash on the WROOM-32; the 2 MB default leaves the upper half unaddressable.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# --- credentials: never baked into the image or this file ---
# Board prompts for SSID/password over the serial console at boot.
CONFIG_EXAMPLE_WIFI_SSID_PWD_FROM_STDIN=y

# --- timing / misc ---
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
